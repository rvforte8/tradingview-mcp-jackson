# Copy to .env and edit. Anything already set in the environment wins over
# this file, so an .mcp.json env block or an inline TV_CHART_ID=... still
# overrides it.

# Pin every tool to one chart window. The value is the slug out of a chart
# URL — tradingview.com/chart/<slug>/ — because CDP target ids are
# regenerated whenever TradingView restarts, and the slug is not.
#
# Leave this unset to let the server pick a window on its own, which is fine
# with one chart open and a coin toss with several.
TV_CHART_ID=
